<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  设计说明（parent 继承机制）：
	  Spring Boot 项目不自己逐个声明依赖版本，而是继承 spring-boot-starter-parent。
	  parent 是一份「已锁好版本号的依赖清单」（类似前端的 package-lock），
	  子模块引入 starter 时只需写 groupId/artifactId，无需写 version。
	  - 版本从 4.1.0 降回 3.5.3：Boot 4 改动了模块命名（starter-web 改名 starter-webmvc），
	    而 MyBatis-Plus 3.5.x 生态主要围绕 Boot 3.x 构建，3.5.3 是学习资料最充足、
	    兼容性最稳的路线。
	  - java.version = 17：Boot 3.5.x 要求 JDK 17+，本机 JAVA_HOME 指向 JDK 21，
	    21 编译 17 目标完全兼容（release 17 由 Boot 父 POM 自动配置）。
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/> <!-- 默认去 Maven 仓库找 parent，本地无仓库时自动下载 -->
	</parent>

	<groupId>fun.ziyun</groupId>
	<artifactId>blog-server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>blog-server</name>
	<description>紫云博客后端服务</description>

	<properties>
		<java.version>17</java.version>

		<!--
		  集中管理「Boot 父 POM 未锁版本」的第三方库版本。
		  原生 MyBatis 时代需要手写：mybatis、mybatis-spring、mybatis-spring-boot-starter
		  三个依赖互相配版本；MyBatis-Plus 的 starter 一个依赖全搞定。
		-->
		<mybatis-plus.version>3.5.7</mybatis-plus.version>
		<minio.version>8.5.17</minio.version>
		<jjwt.version>0.12.6</jjwt.version>
	</properties>

	<dependencies>
		<!--
		  核心 Web 依赖：内置内嵌 Tomcat + Spring MVC。
		  注意 Boot 4 已将其改名为 spring-boot-starter-webmvc，
		  本项目锁 3.5.3 所以沿用经典命名 spring-boot-starter-web。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!--
		  Spring Security：P2 阶段启用 JWT 认证与接口鉴权。
		  P0 阶段曾注释本依赖（避免默认随机密码+全接口拦截噪音），
		  现在 SecurityConfig + JwtAuthenticationFilter 已就绪，恢复依赖。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
		  JSR-380 参数校验（@Valid/@NotNull/@Size 等）。
		  传统写法：Controller 里手写 if/else 逐字段判断；
		  加了这个 starter 后，DTO 字段上声明注解 + @Valid 即可自动校验，
		  校验失败抛 MethodArgumentNotValidException，由 GlobalExceptionHandler 统一接管。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
		  Spring Data Redis：P2 阶段用于存登录态（踢下线/防篡改）。
		  自带 Lettuce 客户端连接池，无需额外引入 jedis。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!--
		  MyBatis-Plus 3.x 专为 Spring Boot 3 提供的 starter。
		  - 原生 MyBatis 需要 XML 手写 mapper SQL + 手动配置 SqlSessionFactory；
		    MP 的 BaseMapper 内置了 selectById/insert/updateById/deleteById 等
		    基础 CRUD，直接用即可（P1 详细展开）。
		  - 锁 3.5.7：3.5.9+ 把 jsqlparser（分页插件底层依赖）拆成独立模块，
		    需要额外引入，学习期用 3.5.7 单依赖最省心。
		-->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>

		<!--
		  MinIO Java SDK：P2 阶段做图片/封面对象存储。
		  注意：这是官方 SDK 而非 Spring 集成，需要自己写 MinioConfig
		  把 MinioClient 注入 Spring 容器（对比 Spring Data 系 starter 的差异点）。
		-->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>${minio.version}</version>
		</dependency>

		<!--
		  JWT 生成/解析：jjwt 0.12.x 三件套。
		  - jjwt-api：只含接口，编译期可见
		  - jjwt-impl：实现，runtime 生效
		  - jjwt-jackson：用 Jackson 做 JSON 序列化（替代旧版 jjwt-gson）
		  runtime 依赖无需写进业务代码 import，与 mysql-connector-j 同理。
		-->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- MySQL 驱动：JDBC 底层依赖，runtime 生效 -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Lombok：编译期注解处理器，生成 getter/setter/构造器等样板代码 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- 测试依赖：JUnit5 + Spring Test + MockMvc -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Spring Security 测试支持（@WithMockUser 等），与 security 主依赖同步恢复。
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
		  阿里云 OSS SDK：对象存储客户端。
		  P2 起通过「存储抽象层」接入（FileService 接口 + 配置开关切换底层），
		  OSS 是当前默认实现，MinIO 实现预留（未来扩展只需新增实现类）。
		  对比 MinIO SDK：接口形态类似（putObject/getObject），
		  因此抽象层方法签名按「最小公共能力」设计（upload/delete），
		  保证换底层时业务代码零改动。
		-->
		<dependency>
			<groupId>com.aliyun.oss</groupId>
			<artifactId>aliyun-sdk-oss</artifactId>
			<version>3.18.5</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  打包插件：把内嵌 Tomcat 一起打进可执行 jar（fat jar）。
			  没有它的话 mvn package 只产出普通 jar，java -jar 无法直接运行。
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
