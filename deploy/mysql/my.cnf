# ============================================================
# 紫云博客 · MySQL 8 小内存专项调优（2C2G 服务器）
# 挂载位置：/etc/mysql/conf.d/ziyun.cnf（自动被 mysqld 读取）
#
# 内存预算：MySQL 容器 mem_limit 512m，以下调优后实际占用约 250MB
# ============================================================
[mysqld]

# 缓冲池 128M -> 64M：博客读多写少、数据量小，64M 足够缓存热数据
innodb_buffer_pool_size = 64M
# 日志缓冲与文件：控制磁盘 IO 与内存占用
innodb_log_buffer_size = 8M
innodb_log_file_size = 64M

# 关闭 performance_schema：官方默认开启，约省 50~100MB 内存
# （代价：失去性能监控数据，个人博客可接受）
performance_schema = OFF

# 连接数上限：HikariCP 连接池上限 10，100 绰绰有余
max_connections = 100
table_open_cache = 500
table_open_cache_instances = 4
thread_cache_size = 32

# 字符集与排序规则（与 init.sql 保持一致）
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# binlog 保留 1 天，防止低配磁盘被日志占满
binlog_expire_logs_seconds = 86400
