# ============================================================
# 紫云博客 · 生产环境变量模板
#
# 用法：本文件只是模板，真实 .env 由 GitHub Actions 部署时
# 根据仓库 Secrets 自动生成在服务器 /opt/ziyun-blog/.env，
# 不会进入 Git 仓库，无需手动维护。
#
# 阿里云 OSS 凭据：务必使用 RAM 子账号（仅授予本 bucket 的
# PutObject/DeleteObject 权限），不要用主账号 AK。
# ============================================================

# Nginx server_name（nginx/blog.conf 里的 __DOMAIN__ 占位符会替换成它）
DOMAIN=ziyun.fun

# MySQL：root 密码（仅容器内部使用）+ 业务账号 blog 的密码
MYSQL_ROOT_PASSWORD=
DB_USERNAME=blog
DB_PASSWORD=

# JWT 签名密钥（>= 32 字节随机串，openssl rand -base64 48）
JWT_SECRET=

# 对象存储：oss（阿里云）。默认复用 application.yml 中的开发凭据
# （华北2 endpoint + bucket ziyun-webstudy-project，见 docker-compose.yml 默认值）。
# 如需独立生产凭据：取消注释并填入 RAM 子账号 AK/SK（推荐，防密钥泄露后无感知）。
STORAGE_TYPE=oss
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=ziyun-webstudy-project
# OSS_BASE_PATH=blog

# 跨域白名单：同域部署（nginx 反代）留空即可
CORS_ALLOWED_ORIGINS=
